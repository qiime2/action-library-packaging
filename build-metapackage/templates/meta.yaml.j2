package:
  name: {{ name }}
  version: {{ version }}

requirements:
  build:
{%- for pkg, ver in packages | items %}
    - {{ pkg }} {{ '{{' }} {{ ver }} {{ '}}' }}
{%- endfor %}

  run:
{%- raw %}
  {%- for package in resolved_packages('build') %}
    {%- if not package.split(' ')[0].startswith('_x86_64-microarch-level') %}
    - {{ package.split(' ')[:2] | join(' ') }}.*
    {%- endif %}
  {% endfor %}
{%- endraw %}

extra:
  rachis:
    integration_git_head_ref: {{ env.GITHUB_HEAD_REF or 'placehold' }}
